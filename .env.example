# ============================================================
# SiteLens AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# --- VLM Backend ---
# Options: ollama | grok | groq | transformers
VLM_BACKEND=groq
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl

# Grok (xAI) API
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-2-vision-latest

# Groq (LPU Cloud) API
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Vector Store ---
# Options: supabase | faiss
VECTOR_BACKEND=faiss
FAISS_INDEX_PATH=data/faiss_index

# Supabase (if VECTOR_BACKEND=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- YOLO Edge Detection ---
YOLO_ENABLED=false
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.5

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Alert Settings ---
CRITICAL_AUDIO_MAX_WORDS=25
FRAME_SKIP=3
